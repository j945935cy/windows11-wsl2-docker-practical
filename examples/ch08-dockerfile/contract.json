{
  "lab": "ch08-dockerfile",
  "checks": [
    {
      "file": "Dockerfile",
      "contains": [
        "FROM python:3.12-slim",
        "WORKDIR /app",
        "COPY app.py /app/app.py",
        "USER 65532:65532",
        "CMD [\"python\", \"/app/app.py\"]"
      ],
      "not_contains": [
        ":latest",
        "docker system prune",
        "docker volume prune",
        "wsl --unregister",
        "C:\\\\Users\\\\"
      ]
    },
    {
      "file": ".dockerignore",
      "contains": [
        ".venv/",
        "tests/"
      ],
      "not_contains": []
    }
  ],
  "integration": [
    [
      "docker",
      "build",
      "-t",
      "wslbook-ch08:local",
      "."
    ],
    [
      "docker",
      "run",
      "--rm",
      "wslbook-ch08:local"
    ]
  ],
  "cleanup": [
    [
      "docker",
      "image",
      "rm",
      "wslbook-ch08:local"
    ]
  ]
}
